<Window
    x:Class="Snarvo.GuideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Snarvo">

    <Grid x:Name="Root" RowDefinitions="Auto,*,Auto">
        <StackPanel Padding="20,16,20,8" Spacing="10">
            <TextBox x:Name="TitleBox" Header="Rubrik" FontSize="18" AutomationProperties.Name="Rubrik"
                     PlaceholderText="Till exempel: Så lägger du upp en ny kund" />
            <TextBox x:Name="IntroBox" Header="Inledning (valfritt)" AutomationProperties.Name="Inledning"
                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="110"
                     PlaceholderText="Vad guiden hjälper till med, och vem den är till för …" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Skriv vad man ska göra i varje steg. Dra stegen, eller använd pilarna, för att ändra ordning." />
        </StackPanel>

        <ListView x:Name="StepsList" Grid.Row="1" Padding="8,0,8,8" SelectionMode="None"
                  CanReorderItems="True" CanDragItems="True" AllowDrop="True">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,6" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:GuideStepItem">
                    <Grid Padding="0,6" ColumnSpacing="16" ColumnDefinitions="220,*,Auto">
                        <Border Height="140" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Image Source="{x:Bind Image.Thumbnail}" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{x:Bind Heading, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBox Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{x:Bind Heading, Mode=OneWay}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"
                                     PlaceholderText="Beskriv vad man ska göra i det här steget …" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                            <Button Click="MoveUp_Click" ToolTipService.ToolTip="Flytta upp" AutomationProperties.Name="Flytta upp">
                                <FontIcon Glyph="&#xE74A;" FontSize="14" />
                            </Button>
                            <Button Click="MoveDown_Click" ToolTipService.ToolTip="Flytta ner" AutomationProperties.Name="Flytta ner">
                                <FontIcon Glyph="&#xE74B;" FontSize="14" />
                            </Button>
                            <Button Click="EditImage_Click" ToolTipService.ToolTip="Rita på bilden i editorn" AutomationProperties.Name="Redigera bilden">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            </Button>
                            <Button Click="Remove_Click" ToolTipService.ToolTip="Ta bort steget ur guiden (skärmdumpen finns kvar i biblioteket)"
                                    AutomationProperties.Name="Ta bort steget">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" Padding="20,12" ColumnSpacing="10" ColumnDefinitions="Auto,Auto,*,Auto"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Button x:Name="PdfButton" AutomationProperties.Name="Spara som PDF" Style="{StaticResource AccentButtonStyle}" Click="SavePdf_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEA90;" FontSize="16" />
                    <TextBlock Text="Spara som PDF …" />
                </StackPanel>
            </Button>
            <Button x:Name="WordButton" AutomationProperties.Name="Spara som Word" Grid.Column="1" Click="SaveWord_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                    <TextBlock Text="Spara som Word …" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Button x:Name="OpenButton" Click="Open_Click" IsEnabled="False" Content="Öppna" />
                <Button x:Name="RevealButton" Click="Reveal_Click" IsEnabled="False" Content="Visa i Utforskaren" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
