<Window
    x:Class="Snarvo.Editor.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:local="using:Snarvo.Editor">

    <Grid x:Name="Root" RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">

        <!-- Top bar: style of the current tool on the left, document actions on the right -->
        <Grid Grid.ColumnSpan="2" Padding="10,6" ColumnSpacing="12" ColumnDefinitions="*,Auto"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">

            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <DropDownButton x:Name="ColorButton" AutomationProperties.Name="Färg" Padding="8,5" ToolTipService.ToolTip="Färg">
                    <Border x:Name="ColorSwatch" Width="22" Height="22" CornerRadius="11"
                            BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <DropDownButton.Flyout>
                        <Flyout>
                            <StackPanel Spacing="10">
                                <VariableSizedWrapGrid x:Name="Swatches" Orientation="Horizontal"
                                                       MaximumRowsOrColumns="6" ItemWidth="40" ItemHeight="40" />
                                <Button Click="Eyedropper_Click" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEF3C;" FontSize="16" />
                                        <TextBlock Text="Hämta färg från bilden (Alt+klick)" />
                                    </StackPanel>
                                </Button>
                                <ColorPicker x:Name="Picker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                             IsColorChannelTextInputVisible="False" IsHexInputVisible="True"
                                             ColorSpectrumShape="Box" ColorChanged="Picker_ColorChanged" />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <StackPanel x:Name="ThicknessPanel" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="ThicknessLabel" Text="Tjocklek" VerticalAlignment="Center" />
                    <Slider x:Name="ThicknessSlider" Width="130" Minimum="1" Maximum="30" StepFrequency="1"
                            VerticalAlignment="Center" ValueChanged="ThicknessSlider_ValueChanged" />
                </StackPanel>

                <Button x:Name="AutoTrimButton" Click="AutoTrim_Click" Visibility="Collapsed"
                        AutomationProperties.Name="Beskär kanter automatiskt"
                        ToolTipService.ToolTip="Ta bort enfärgade kanter runt bilden (Ctrl+Shift+K)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7A8;" FontSize="16" />
                        <TextBlock Text="Beskär kanter automatiskt" />
                    </StackPanel>
                </Button>

                <StackPanel x:Name="FontPanel" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="FontLabel" Text="Textstorlek" VerticalAlignment="Center" />
                    <Slider x:Name="FontSlider" Width="130" Minimum="10" Maximum="96" StepFrequency="1"
                            VerticalAlignment="Center" ValueChanged="FontSlider_ValueChanged" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ActionBar" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Click="Undo_Click" AutomationProperties.Name="Ångra" ToolTipService.ToolTip="Ångra (Ctrl+Z)">
                    <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                </Button>
                <Button x:Name="RedoButton" Click="Redo_Click" AutomationProperties.Name="Gör om" ToolTipService.ToolTip="Gör om (Ctrl+Y)">
                    <FontIcon Glyph="&#xE7A6;" FontSize="16" />
                </Button>

                <Border Width="1" Margin="6,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <DropDownButton AutomationProperties.Name="Mallar" ToolTipService.ToolTip="Spara och använd mallar med färger, storlekar och effekter">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A9;" FontSize="16" />
                        <TextBlock Text="Mallar" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="PresetsMenu" Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>

                <DropDownButton AutomationProperties.Name="Effekter" ToolTipService.ToolTip="Ram, rundade hörn och skugga">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE771;" FontSize="16" />
                        <TextBlock Text="Effekter" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <Flyout Opening="EffectsFlyout_Opening">
                            <StackPanel Width="260" Spacing="6">
                                <ToggleSwitch x:Name="ShadowToggle" Header="Skugga" Toggled="ShadowToggle_Toggled" />
                                <Slider x:Name="BorderSlider" Header="Ram" Minimum="0" Maximum="40" StepFrequency="1"
                                        ValueChanged="BorderSlider_ValueChanged" />
                                <StackPanel x:Name="BorderSwatches" Orientation="Horizontal" Spacing="6" />
                                <Slider x:Name="RadiusSlider" Header="Rundade hörn" Minimum="0" Maximum="40" StepFrequency="1"
                                        Margin="0,8,0,0" ValueChanged="RadiusSlider_ValueChanged" />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <SplitButton Click="HideSensitive_SplitClick" AutomationProperties.Name="Dölj känsligt"
                             ToolTipService.ToolTip="Hitta och pixla e-post, telefonnummer, personnummer, kortnummer, lösenord och nycklar automatiskt (Ctrl+H). Pilen: dölj ett visst ord eller namn.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72E;" FontSize="16" />
                        <TextBlock Text="Dölj känsligt" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Dölj känslig information" Click="HideSensitive_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAcceleratorTextOverride>Ctrl+H</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="HideWordsItem" Text="Dölj ord eller namn …" Click="HideWords_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAcceleratorTextOverride>Ctrl+Shift+H</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Button Click="Simplify_Click" AutomationProperties.Name="Förenkla"
                        ToolTipService.ToolTip="Byt ut texten i bilden mot grå block, så att det viktiga syns. Ta bort enskilda block för att visa den texten igen.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE700;" FontSize="16" />
                        <TextBlock Text="Förenkla" />
                    </StackPanel>
                </Button>
                <Button Click="Ocr_Click" AutomationProperties.Name="Text i bilden" ToolTipService.ToolTip="Läs ut texten i bilden (OCR)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C1;" FontSize="16" />
                        <TextBlock Text="Text" />
                    </StackPanel>
                </Button>

                <Border Width="1" Margin="6,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Not a Button: a Button swallows the pointer press that starts the drag -->
                <Border x:Name="DragOut" CanDrag="True" DragStarting="DragOut_DragStarting"
                        Padding="11,5" CornerRadius="{ThemeResource ControlCornerRadius}" BorderThickness="1"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        ToolTipService.ToolTip="Dra härifrån och släpp i ett annat program – Teams, Outlook, Slack, Utforskaren …">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7C2;" FontSize="16" />
                        <TextBlock Text="Dra ut" />
                    </StackPanel>
                </Border>
                <DropDownButton AutomationProperties.Name="Dela" ToolTipService.ToolTip="Spara i en vald mapp (t.ex. OneDrive) eller kopiera som fil">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72D;" FontSize="16" />
                        <TextBlock Text="Dela" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="QuickSaveItem" Text="Spara i mapp …" Click="QuickSave_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Kopiera som fil" Click="CopyAsFile_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAcceleratorTextOverride>Ctrl+Shift+C</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="KeepItem" Text="Behåll i biblioteket" Click="Keep_Click" Visibility="Collapsed"
                                            ToolTipService.ToolTip="Privat läge: spara just den här bilden i biblioteket i stället för att radera den">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="CopyOnCloseItem" Text="Kopiera bilden när editorn stängs" Click="CopyOnClose_Click"
                                                  ToolTipService.ToolTip="Rita, stäng och klistra in – utan Ctrl+C" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Välj mapp …" Click="ChooseQuickSaveFolder_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="OpenQuickSaveFolderItem" Text="Öppna mappen" Click="OpenQuickSaveFolder_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <!-- Label as direct content so the compact toolbar never hides it -->
                <DropDownButton x:Name="ExportSizeButton" AutomationProperties.Name="Storlek vid delning" MinWidth="70">
                    <TextBlock x:Name="ExportSizeLabel" Text="100 %" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ExportSizeMenu" Placement="BottomEdgeAlignedRight" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Click="Copy_Click" AutomationProperties.Name="Kopiera" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Kopiera bilden (Ctrl+C)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                        <TextBlock Text="Kopiera" />
                    </StackPanel>
                </Button>
                <Button Click="Save_Click" AutomationProperties.Name="Spara" ToolTipService.ToolTip="Spara i biblioteket (Ctrl+S)">
                    <FontIcon Glyph="&#xE74E;" FontSize="16" />
                </Button>
                <Button Click="Export_Click" AutomationProperties.Name="Exportera" ToolTipService.ToolTip="Exportera som fil (Ctrl+Shift+S)">
                    <FontIcon Glyph="&#xE792;" FontSize="16" />
                </Button>
                <Button Click="Library_Click" AutomationProperties.Name="Bibliotek" ToolTipService.ToolTip="Öppna biblioteket">
                    <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tool rail -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <StackPanel x:Name="ToolRail" Padding="6" Spacing="2" />
        </ScrollViewer>

        <!-- Canvas -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" Grid.Column="1"
                      ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="8"
                      HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      IsTabStop="True" UseSystemFocusVisuals="False" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                      ViewChanged="Scroller_ViewChanged">
            <local:CursorHost x:Name="Host" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <canvas:CanvasVirtualControl x:Name="Board" UseSharedDevice="True" ClearColor="Transparent"
                                      RegionsInvalidated="Board_RegionsInvalidated"
                                      PointerPressed="Board_PointerPressed" PointerMoved="Board_PointerMoved"
                                      PointerReleased="Board_PointerReleased" PointerCaptureLost="Board_PointerCaptureLost"
                                      DoubleTapped="Board_DoubleTapped" />
                <Canvas x:Name="Overlay" />
            </local:CursorHost>
        </ScrollViewer>

        <!-- Status bar -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Padding="12,4" ColumnSpacing="12" ColumnDefinitions="*,Auto"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="HintText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="SizeText" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <HyperlinkButton Content="Anpassa" Click="ZoomFit_Click" ToolTipService.ToolTip="Anpassa till fönstret (Ctrl+0)" />
                <HyperlinkButton Content="100 %" Click="ZoomActual_Click" ToolTipService.ToolTip="Faktisk storlek (Ctrl+1)" />
                <TextBlock x:Name="ZoomText" MinWidth="48" TextAlignment="Right" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
