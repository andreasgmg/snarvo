<Window
    x:Class="Snarvo.VideoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Padding="16" RowSpacing="14" RowDefinitions="*,Auto,Auto,Auto">
        <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True" Stretch="Uniform" />

        <!-- Trim -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <Button Click="SetStart_Click" ToolTipService.ToolTip="GIF:en börjar vid den här punkten i videon">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE892;" FontSize="16" />
                    <TextBlock Text="Start här" />
                </StackPanel>
            </Button>
            <Button Click="SetEnd_Click" ToolTipService.ToolTip="GIF:en slutar vid den här punkten i videon">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                    <TextBlock Text="Slut här" />
                </StackPanel>
            </Button>
            <Button Click="ResetTrim_Click" Content="Hela videon" />
            <TextBlock x:Name="TrimText" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <!-- Output settings -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
            <ComboBox x:Name="FpsBox" Header="Bildfrekvens" MinWidth="130" SelectionChanged="Settings_Changed" />
            <ComboBox x:Name="WidthBox" Header="Bredd" MinWidth="150" SelectionChanged="Settings_Changed" />
            <TextBlock x:Name="EstimateText" VerticalAlignment="Bottom" Margin="0,0,0,6"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Save -->
        <Grid Grid.Row="3" ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto">
            <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" Click="Save_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="16" />
                    <TextBlock Text="Spara som GIF …" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="Progress" Maximum="1" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CopyFileButton" Click="CopyFile_Click" IsEnabled="False" Content="Kopiera som fil"
                        ToolTipService.ToolTip="Klistra in GIF:en i Teams, Slack, Utforskaren …" />
                <Button x:Name="RevealButton" Click="Reveal_Click" IsEnabled="False" Content="Visa i Utforskaren" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
